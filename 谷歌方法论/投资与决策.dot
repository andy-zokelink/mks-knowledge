digraph G {
    rankdir=TB;
    bgcolor="#fdf6ec";
    fontname="PingFang SC,Noto Sans SC,Microsoft YaHei,sans-serif";
    node [fontname="PingFang SC,Noto Sans SC,Microsoft YaHei,sans-serif"];
    edge [fontname="PingFang SC,Noto Sans SC,Microsoft YaHei,sans-serif"];
    compound=true;
    nodesep=0.6;
    ranksep=0.8;

    // Root
    root [label="资本与决策的核心驱动\n风险认知 × 价值判断 × 时间偏好",
          shape=box, style="filled,rounded", fillcolor="#c0392b", fontcolor="white",
          fontsize=14, penwidth=0, margin="0.15,0.1"];

    // Level 1 - 4 main branches
    subgraph cluster_l1 {
        bgcolor="#fdf6ec";
        label="";
        style=invis;
        l1_vc [label="风险投资运作\n起源→基金结构→投后→退出",
               shape=box, style="filled,rounded", fillcolor="#d4a574", fontcolor="white",
               fontsize=12, penwidth=0];
        l1_phil [label="投资大师哲学\n杜尔 · 林奇 · 米勒",
                 shape=box, style="filled,rounded", fillcolor="#d4a574", fontcolor="white",
                 fontsize=12, penwidth=0];
        l1_money [label="货币与金融\n金本位→信用货币→区块链",
                  shape=box, style="filled,rounded", fillcolor="#d4a574", fontcolor="white",
                  fontsize=12, penwidth=0];
        l1_org [label="组织决策思维\n管理 × 止损 × 制度",
                shape=box, style="filled,rounded", fillcolor="#d4a574", fontcolor="white",
                fontsize=12, penwidth=0];
    }

    // Level 2 nodes
    l2_fairchild [label="仙童半导体\n现代VC起源",
                  shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                  color="#e8d5c4", fontsize=10];
    l2_fund [label="基金结构\nLP/GP·7+3年",
             shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
             color="#e8d5c4", fontsize=10];
    l2_doerr [label="约翰·杜尔\n投人·影响力",
              shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
              color="#e8d5c4", fontsize=10];
    l2_lynch [label="彼得·林奇\nPEG·须鲸法",
              shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
              color="#e8d5c4", fontsize=10];
    l2_gold [label="金本位\n抵押→信用",
             shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
             color="#e8d5c4", fontsize=10];
    l2_blockchain [label="区块链\n生产关系重构",
                   shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                   color="#e8d5c4", fontsize=10];
    l2_matrix [label="矩阵式管理\n双重汇报",
               shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
               color="#e8d5c4", fontsize=10];
    l2_jcurve [label="J曲线/止损\n滞后·厄运链",
               shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
               color="#e8d5c4", fontsize=10];

    // Level 3 - cross connections
    l3_drucker [label="德鲁克定律\n贡献 > 成就",
                shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                color="#d4a574", fontsize=10, penwidth=1.5];
    l3_ogilvy [label="奥格威定律\n雇用更强的人",
               shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
               color="#d4a574", fontsize=10, penwidth=1.5];
    l3_corecomp [label="核心竞争力\n整合 > 自有技术",
                 shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                 color="#d4a574", fontsize=10, penwidth=1.5];
    l3_usmca [label="美墨加协定\n制度动态改良",
              shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
              color="#27ae60", fontsize=10, penwidth=1.5, style="filled,dashed"];

    // Level 4 - tool layer
    l4_peg [label="PEG指标\n林奇秘密武器",
            shape=box, style="filled,rounded", fillcolor="#fdf6ec", fontcolor="#5a3e3e",
            color="#e8d5c4", fontsize=9];
    l4_cb [label="央行平衡表\n扩表/缩表",
           shape=box, style="filled,rounded", fillcolor="#fdf6ec", fontcolor="#5a3e3e",
           color="#e8d5c4", fontsize=9];
    l4_siege [label="攻城与守城\n资源配置",
              shape=box, style="filled,rounded", fillcolor="#fdf6ec", fontcolor="#5a3e3e",
              color="#e8d5c4", fontsize=9];

    // Edges: Root → L1
    root -> l1_vc [color="#c0392b", penwidth=2];
    root -> l1_phil [color="#c0392b", penwidth=2];
    root -> l1_money [color="#c0392b", penwidth=2];
    root -> l1_org [color="#c0392b", penwidth=2];

    // Edges: L1 → L2
    l1_vc -> l2_fairchild [color="#d4a574", penwidth=1.5];
    l1_vc -> l2_fund [color="#d4a574", penwidth=1.5];
    l1_phil -> l2_doerr [color="#d4a574", penwidth=1.5];
    l1_phil -> l2_lynch [color="#d4a574", penwidth=1.5];
    l1_money -> l2_gold [color="#d4a574", penwidth=1.5];
    l1_money -> l2_blockchain [color="#d4a574", penwidth=1.5];
    l1_org -> l2_matrix [color="#d4a574", penwidth=1.5];
    l1_org -> l2_jcurve [color="#d4a574", penwidth=1.5];

    // Edges: L2 → L3 (cross connections)
    l2_doerr -> l3_drucker [color="#2980b9", penwidth=1.5];
    l2_lynch -> l3_ogilvy [color="#2980b9", penwidth=1.5];
    l2_blockchain -> l3_corecomp [color="#2980b9", penwidth=1.5];
    l2_jcurve -> l3_usmca [color="#27ae60", penwidth=1.5, style=dashed];

    // Edges: L3 → L4
    l3_ogilvy -> l4_peg [color="#d4a574", penwidth=1];
    l3_corecomp -> l4_cb [color="#d4a574", penwidth=1];
    l3_corecomp -> l4_siege [color="#d4a574", penwidth=1];

    // Edge labels
    { rank=same; l1_vc; l1_phil; l1_money; l1_org; }
    { rank=same; l3_drucker; l3_ogilvy; l3_corecomp; l3_usmca; }
    { rank=same; l4_peg; l4_cb; l4_siege; }
}

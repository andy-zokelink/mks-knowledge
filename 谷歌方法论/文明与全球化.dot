digraph G {
    rankdir=TB;
    bgcolor="#fdf6ec";
    fontname="PingFang SC,Noto Sans SC,Microsoft YaHei,sans-serif";
    node [fontname="PingFang SC,Noto Sans SC,Microsoft YaHei,sans-serif"];
    edge [fontname="PingFang SC,Noto Sans SC,Microsoft YaHei,sans-serif"];
    compound=true;
    nodesep=0.5;
    ranksep=0.8;

    // Root
    root [label="文明演进的核心驱动\n能量 × 信息 × 合作",
          shape=box, style="filled,rounded", fillcolor="#c0392b", fontcolor="white",
          fontsize=14, penwidth=0, margin="0.15,0.1"];

    // Level 1 - Three core drives
    l1_energy [label="能量驱动\nE=mc² · 世界本质",
               shape=box, style="filled,rounded", fillcolor="#d4a574", fontcolor="white",
               fontsize=12, penwidth=0];
    l1_info [label="信息驱动\n熵 · 信息论 · 沟通",
             shape=box, style="filled,rounded", fillcolor="#d4a574", fontcolor="white",
             fontsize=12, penwidth=0];
    l1_coop [label="合作驱动\n非零和博弈",
             shape=box, style="filled,rounded", fillcolor="#d4a574", fontcolor="white",
             fontsize=12, penwidth=0];

    // Level 2 sub-nodes
    subgraph cluster_l2_energy {
        bgcolor="#fdf6ec"; style=invis; label="";
        l2_bigbang [label="宇宙大爆炸\n能量奇点起源",
                    shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                    color="#e8d5c4", fontsize=10];
        l2_higgs [label="希格斯场\n赋予质量·上帝粒子",
                  shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                  color="#e8d5c4", fontsize=10];
    }
    subgraph cluster_l2_info {
        bgcolor="#fdf6ec"; style=invis; label="";
        l2_shannon [label="香农信息论\n消除不确定性",
                    shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                    color="#e8d5c4", fontsize=10];
        l2_112 [label="1+1=2\n抽象·因果·确定性",
                shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                color="#e8d5c4", fontsize=10];
        l2_andybill [label="安迪-比尔定律\n软硬件共生迭代",
                     shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                     color="#e8d5c4", fontsize=10];
    }
    subgraph cluster_l2_coop {
        bgcolor="#fdf6ec"; style=invis; label="";
        l2_commerce [label="商业文明\n合同·信用·交换",
                     shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                     color="#e8d5c4", fontsize=10];
        l2_rules [label="规则建立\n掠夺→守规矩",
                  shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                  color="#e8d5c4", fontsize=10];
    }

    // Level 3 - Leaf nodes
    l3_moore [label="摩尔定律\n晶体管密度翻倍",
              shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
              color="#d4a574", fontsize=9, penwidth=1];
    l3_ricardo [label="李嘉图定律\n优质资源溢价",
                shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                color="#d4a574", fontsize=9, penwidth=1];
    l3_deeplearn [label="深度学习\nAI三剑客·图灵奖",
                  shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                  color="#d4a574", fontsize=9, penwidth=1];
    l3_traveler [label="旅行者困境\n过度理性→双输",
                 shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                 color="#d4a574", fontsize=9, penwidth=1];
    l3_greek [label="希腊文明\n欧洲文化原点",
              shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
              color="#d4a574", fontsize=9, penwidth=1];
    l3_bismarck [label="俾斯麦智慧\n外交优先·强目的性",
                 shape=box, style="filled,rounded", fillcolor="#fffaf2", fontcolor="#5a3e3e",
                 color="#d4a574", fontsize=9, penwidth=1];

    // Level 4 - Outcome nodes
    l4_trade [label="全球化贸易\n瓷器·青花瓷·香料·货币",
              shape=box, style="filled,rounded", fillcolor="#d4a574", fontcolor="white",
              fontsize=10, penwidth=0];
    l4_uscn [label="中美竞争与合作\n教育·科技·贸易·知识产权",
             shape=box, style="filled,rounded", fillcolor="#d4a574", fontcolor="white",
             fontsize=10, penwidth=0];
    l4_humanism [label="人文精神\n莎士比亚·歌剧·旅游审美",
                 shape=box, style="filled,rounded", fillcolor="#d4a574", fontcolor="white",
                 fontsize=10, penwidth=0];

    // Edges: Root → L1
    root -> l1_energy [color="#c0392b", penwidth=2.5];
    root -> l1_info [color="#c0392b", penwidth=2.5];
    root -> l1_coop [color="#c0392b", penwidth=2.5];

    // Edges: L1 → L2
    l1_energy -> l2_bigbang [color="#d4a574", penwidth=1.5];
    l1_energy -> l2_higgs [color="#d4a574", penwidth=1.5];
    l1_info -> l2_shannon [color="#d4a574", penwidth=1.5];
    l1_info -> l2_112 [color="#d4a574", penwidth=1.5];
    l1_info -> l2_andybill [color="#d4a574", penwidth=1.5];
    l1_coop -> l2_commerce [color="#d4a574", penwidth=1.5];
    l1_coop -> l2_rules [color="#d4a574", penwidth=1.5];

    // Edges: L2 → L3 (cross-domain)
    l2_bigbang -> l3_moore [color="#d4a574", penwidth=1];
    l2_112 -> l3_ricardo [color="#d4a574", penwidth=1];
    l2_shannon -> l3_deeplearn [color="#d4a574", penwidth=1];
    l2_112 -> l3_traveler [color="#d4a574", penwidth=1];
    l2_commerce -> l3_greek [color="#d4a574", penwidth=1];
    l2_rules -> l3_bismarck [color="#d4a574", penwidth=1];

    // Edges: L3 → L4
    l3_moore -> l4_trade [color="#d4a574", penwidth=1, style=dashed];
    l3_ricardo -> l4_trade [color="#d4a574", penwidth=1, style=dashed];
    l3_deeplearn -> l4_uscn [color="#d4a574", penwidth=1, style=dashed];
    l3_traveler -> l4_uscn [color="#d4a574", penwidth=1, style=dashed];
    l3_greek -> l4_humanism [color="#d4a574", penwidth=1, style=dashed];
    l3_bismarck -> l4_humanism [color="#d4a574", penwidth=1, style=dashed];

    // Cross-domain links
    l1_energy -> l1_info [color="#d4a574", penwidth=1, style=dashed, dir=none];
    l1_info -> l1_coop [color="#d4a574", penwidth=1, style=dashed, dir=none];

    // Ranks
    { rank=same; l1_energy; l1_info; l1_coop; }
    { rank=same; l3_moore; l3_ricardo; l3_deeplearn; l3_traveler; l3_greek; l3_bismarck; }
    { rank=same; l4_trade; l4_uscn; l4_humanism; }
}
